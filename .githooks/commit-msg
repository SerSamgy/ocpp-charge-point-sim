#!/bin/sh
# Validates the first line of a commit message against Conventional Commits:
#   type(scope)!: subject
# Enable once per clone: git config core.hooksPath .githooks

msg_file=$1

# First line that is not a comment.
line=$(grep -v '^#' "$msg_file" | head -n 1)

# Messages generated by git are left alone.
case $line in
    'Merge '* | 'Revert "'* | 'fixup! '* | 'squash! '*) exit 0 ;;
esac

fail() {
    echo "commit-msg: $1" >&2
    echo "  got:      $line" >&2
    echo "  expected: type(scope)!: subject" >&2
    echo "  types:    feat fix refactor perf test docs build ci chore style revert" >&2
    echo "  (scope) and ! are optional; subject <= 72 chars, no trailing period" >&2
    exit 1
}

types='feat|fix|refactor|perf|test|docs|build|ci|chore|style|revert'
if ! printf '%s\n' "$line" |
    grep -Eq "^($types)(\([^()[:space:]]+\))?!?: [^[:space:]]"; then
    fail "first line does not match the format"
fi

subject=${line#*: }
if [ "${#subject}" -gt 72 ]; then
    fail "subject is ${#subject} characters, max 72"
fi

case $subject in
    *.) fail "subject must not end with a period" ;;
esac

exit 0
