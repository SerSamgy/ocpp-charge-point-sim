{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_SHELL": "/bin/bash"
  },
  "permissions": {
    "allow": [
      "Read(/**)",
      "Edit(/**)",
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(just test)",
      "Bash(just build-pi)",
      "Bash(just csms)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:doc.rust-lang.org)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:code.claude.com)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(cargo add *)",
      "Bash(cargo remove *)",
      "Edit(Cargo.toml)",
      "Edit(csms/pyproject.toml)",
      "Bash(cargo install *)",
      "Bash(rustup *)",
      "Bash(uv tool install *)",
      "Bash(uv add *)",
      "Bash(just deploy *)",
      "Bash(scp *)",
      "Bash(ssh *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Edit(.claude/**)",
      "Edit(justfile)",
      "Edit(.githooks/**)",
      "Edit(.github/workflows/**)",
      "Edit(**/build.rs)",
      "Bash(curl *)",
      "Bash(wget *)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit -an*)",
      "Bash(git commit * -n*)",
      "Bash(git config *)",
      "Bash(gh auth *)",
      "Bash(gh secret *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(gh api *)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.aws/**)",
      "Read(//**/.env*)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Bash(sudo *)",
      "Edit(//etc/**)",
      "Edit(//usr/**)",
      "Edit(//bin/**)",
      "Edit(//sbin/**)",
      "Edit(//lib/**)",
      "Edit(//opt/**)",
      "Edit(//var/**)",
      "Edit(//boot/**)",
      "Edit(//root/**)"
    ]
  }
}
