+++ b/crates/cp-sim/src/main.rs
@@ -0,0 +1,128 @@
+use std::{error::Error, time::Duration};
+
+use futures_util::{SinkExt, StreamExt};
+use ocpp_proto::{
+    Frame,
+    v16::{BootNotificationRequest, BootNotificationResponse, HeartbeatRequest, RegistrationStatus},
+};
+use tokio_tungstenite::{
+    connect_async,
+    tungstenite::{Message, client::IntoClientRequest, http::HeaderValue},
+};
+use uuid::Uuid;
+
+const DEFAULT_CSMS_URL: &str = "ws://localhost:9000/CP001";
+
+/// Frame -> WebSocket text message, with logging in one place.
+fn to_msg(frame: &Frame) -> Message {
+    let text = frame.to_json();
+    println!(">> {text}");
+    Message::text(text)
+}
+
+fn new_id() -> String {
+    Uuid::new_v4().to_string()
+}
+
+#[tokio::main]
+async fn main() -> Result<(), Box<dyn Error>> {
+    let url = std::env::args()
+        .nth(1)
+        .unwrap_or_else(|| DEFAULT_CSMS_URL.to_string());
+
+    // --- 1. Connect with sub-protocol ocpp1.6 ---
+    let mut request = url.as_str().into_client_request()?;
+    request
+        .headers_mut()
+        .insert("Sec-WebSocket-Protocol", HeaderValue::from_static("ocpp1.6"));
+    let (ws, _response) = connect_async(request).await?;
+    println!("Connected to {url}");
+
+    let (mut write, mut read) = ws.split();
+
+    // --- 2. BootNotification ---
+    let req = BootNotificationRequest {
+        charge_point_vendor: "Semyon".into(),
+        charge_point_model: "cp-sim".into(),
+        ..Default::default()
+    };
+    let boot_id = new_id();
+    write.send(to_msg(&Frame::call(&boot_id, &req)?)).await?;
+
+    let boot: BootNotificationResponse = loop {
+        let Some(msg) = read.next().await else {
+            return Err("connection closed before BootNotification response".into());
+        };
+        let Message::Text(text) = msg? else { continue };
+        println!("<< {text}");
+
+        let frame = match Frame::parse(text.as_str()) {
+            Ok(f) => f,
+            Err(e) => {
+                eprintln!("bad frame, ignored: {e}");
+                continue;
+            }
+        };
+        match frame {
+            Frame::CallResult { id, payload } if id == boot_id => {
+                break serde_json::from_value(payload)?;
+            }
+            Frame::CallError { id, code, description, .. } if id == boot_id => {
+                return Err(format!("BootNotification failed: {code}: {description}").into());
+            }
+            other => eprintln!("unexpected before boot, ignored: {other:?}"),
+        }
+    };
+
+    if boot.status != RegistrationStatus::Accepted {
+        // Step 3c: retry after boot.interval instead of exiting
+        return Err(format!("boot not accepted: {:?}", boot.status).into());
+    }
+    // tokio::time::interval panics on a zero period, and interval=0 is legal on the wire
+    let interval_secs = u64::from(boot.interval.max(1));
+    println!("accepted, heartbeat every {interval_secs}s");
+
+    // --- 3. Heartbeat + input read simultaneously ---
+    let mut ticker = tokio::time::interval(Duration::from_secs(interval_secs));
+    ticker.tick().await; // first tick fires immediately — skip it
+
+    loop {
+        tokio::select! {
+            _ = ticker.tick() => {
+                write.send(to_msg(&Frame::call(new_id(), &HeartbeatRequest {})?)).await?;
+            }
+            msg = read.next() => {
+                match msg {
+                    Some(Ok(Message::Text(text))) => {
+                        println!("<< {text}");
+                        match Frame::parse(text.as_str()) {
+                            // Request from the server: nothing is supported yet
+                            Ok(Frame::Call { id, action, .. }) => {
+                                let reply = Frame::error(id, "NotImplemented", &format!("{action} is not supported"));
+                                write.send(to_msg(&reply)).await?;
+                            }
+                            // Responses (Heartbeat etc.): routing by ID comes in step 3b
+                            Ok(Frame::CallResult { .. }) => {}
+                            Ok(Frame::CallError { id, code, description, .. }) => {
+                                eprintln!("CALLERROR for {id}: {code}: {description}");
+                            }
+                            Err(e) => eprintln!("bad frame, ignored: {e}"),
+                        }
+                    }
+                    Some(Ok(Message::Close(frame))) => {
+                        println!("server closed connection: {frame:?}");
+                        break;
+                    }
+                    Some(Ok(_)) => {} // ping/pong/binary — tungstenite answers ping itself
+                    Some(Err(e)) => return Err(e.into()),
+                    None => {
+                        println!("connection closed");
+                        break;
+                    }
+                }
+            }
+        }
+    }
+
+    Ok(())
+}
