index 0000000..9174d09
--- /dev/null
+++ b/crates/ocpp-proto/src/frame.rs
@@ -0,0 +1,240 @@
+//! OCPP-J RPC framing: every message — JSON-array.
+//!   CALL:       [2, "<id>", "<Action>", {payload}]
+//!   CALLRESULT: [3, "<id>", {payload}]
+//!   CALLERROR:  [4, "<id>", "<ErrorCode>", "<description>", {details}]
+
+use crate::Request;
+use serde::de::{self, Deserializer};
+use serde::ser::{SerializeSeq, Serializer};
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+
+const CALL: u8 = 2;
+const CALL_RESULT: u8 = 3;
+const CALL_ERROR: u8 = 4;
+
+#[derive(Debug, Clone, PartialEq)]
+pub enum Frame {
+    Call {
+        id: String,
+        action: String,
+        payload: Value,
+    },
+    CallResult {
+        id: String,
+        payload: Value,
+    },
+    CallError {
+        id: String,
+        code: String,
+        description: String,
+        details: Value,
+    },
+}
+
+#[derive(Debug, thiserror::Error)]
+pub enum FrameError {
+    #[error("invalid JSON: {0}")]
+    Json(#[from] serde_json::Error),
+}
+
+impl Frame {
+    /// Собрать CALL из типизированного запроса.
+    pub fn call<R: Request>(id: impl Into<String>, req: &R) -> Result<Self, FrameError> {
+        Ok(Frame::Call {
+            id: id.into(),
+            action: R::ACTION.to_string(),
+            payload: serde_json::to_value(req)?,
+        })
+    }
+
+    /// Собрать CALLRESULT в ответ на запрос сервера.
+    pub fn result<T: Serialize>(id: impl Into<String>, resp: &T) -> Result<Self, FrameError> {
+        Ok(Frame::CallResult {
+            id: id.into(),
+            payload: serde_json::to_value(resp)?,
+        })
+    }
+
+    /// Собрать CALLERROR (например, NotImplemented на неизвестный action).
+    pub fn error(id: impl Into<String>, code: &str, description: &str) -> Self {
+        Frame::CallError {
+            id: id.into(),
+            code: code.to_string(),
+            description: description.to_string(),
+            details: Value::Object(Default::default()),
+        }
+    }
+
+    pub fn id(&self) -> &str {
+        match self {
+            Frame::Call { id, .. } | Frame::CallResult { id, .. } | Frame::CallError { id, .. } => {
+                id
+            }
+        }
+    }
+
+    pub fn parse(text: &str) -> Result<Self, FrameError> {
+        Ok(serde_json::from_str(text)?)
+    }
+
+    pub fn to_json(&self) -> String {
+        // Сериализация Frame не может упасть: внутри только строки и Value.
+        serde_json::to_string(self).expect("Frame serialization is infallible")
+    }
+}
+
+impl Serialize for Frame {
+    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
+        match self {
+            Frame::Call {
+                id,
+                action,
+                payload,
+            } => {
+                let mut seq = s.serialize_seq(Some(4))?;
+                seq.serialize_element(&CALL)?;
+                seq.serialize_element(id)?;
+                seq.serialize_element(action)?;
+                seq.serialize_element(payload)?;
+                seq.end()
+            }
+            Frame::CallResult { id, payload } => {
+                let mut seq = s.serialize_seq(Some(3))?;
+                seq.serialize_element(&CALL_RESULT)?;
+                seq.serialize_element(id)?;
+                seq.serialize_element(payload)?;
+                seq.end()
+            }
+            Frame::CallError {
+                id,
+                code,
+                description,
+                details,
+            } => {
+                let mut seq = s.serialize_seq(Some(5))?;
+                seq.serialize_element(&CALL_ERROR)?;
+                seq.serialize_element(id)?;
+                seq.serialize_element(code)?;
+                seq.serialize_element(description)?;
+                seq.serialize_element(details)?;
+                seq.end()
+            }
+        }
+    }
+}
+
+impl<'de> Deserialize<'de> for Frame {
+    fn deserialize<D: Deserializer<'de>>(d: D) -> Result<Self, D::Error> {
+        // Сначала читаем массив произвольных JSON-значений, потом разбираем по типу.
+        let arr = Vec::<Value>::deserialize(d)?;
+        let ty = arr
+            .first()
+            .and_then(Value::as_u64)
+            .ok_or_else(|| de::Error::custom("first element must be message type id"))?;
+
+        let str_at = |i: usize, what: &str| -> Result<String, D::Error> {
+            arr.get(i)
+                .and_then(Value::as_str)
+                .map(str::to_owned)
+                .ok_or_else(|| de::Error::custom(format!("element {i} ({what}) must be a string")))
+        };
+        let expect_len = |n: usize| -> Result<(), D::Error> {
+            if arr.len() == n {
+                Ok(())
+            } else {
+                Err(de::Error::custom(format!(
+                    "type {ty}: expected {n} elements, got {}",
+                    arr.len()
+                )))
+            }
+        };
+
+        match ty {
+            2 => {
+                expect_len(4)?;
+                Ok(Frame::Call {
+                    id: str_at(1, "id")?,
+                    action: str_at(2, "action")?,
+                    payload: arr[3].clone(),
+                })
+            }
+            3 => {
+                expect_len(3)?;
+                Ok(Frame::CallResult {
+                    id: str_at(1, "id")?,
+                    payload: arr[2].clone(),
+                })
+            }
+            4 => {
+                expect_len(5)?;
+                Ok(Frame::CallError {
+                    id: str_at(1, "id")?,
+                    code: str_at(2, "errorCode")?,
+                    description: str_at(3, "errorDescription")?,
+                    details: arr[4].clone(),
+                })
+            }
+            other => Err(de::Error::custom(format!(
+                "unknown message type id {other}"
+            ))),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::v16::{BootNotificationRequest, BootNotificationResponse, RegistrationStatus};
+    use serde_json::json;
+
+    #[test]
+    fn call_roundtrip() {
+        let req = BootNotificationRequest {
+            charge_point_vendor: "Ampeco".into(),
+            charge_point_model: "cp-test".into(),
+            ..Default::default()
+        };
+        let f = Frame::call("42", &req).unwrap();
+        let text = f.to_json();
+        assert_eq!(
+            serde_json::from_str::<Value>(&text).unwrap(),
+            json!([2, "42", "BootNotification", {"chargePointVendor": "Ampeco", "chargePointModel": "cp-test"}])
+        );
+        assert_eq!(Frame::parse(&text).unwrap(), f);
+    }
+
+    #[test]
+    fn parse_call_result_into_typed_response() {
+        let text =
+            r#"[3,"42",{"status":"Accepted","currentTime":"2026-10-02T12:00:00","interval":10}]"#;
+        let Frame::CallResult { id, payload } = Frame::parse(text).unwrap() else {
+            panic!("not a CallResult")
+        };
+        assert_eq!(id, "42");
+        let resp: BootNotificationResponse = serde_json::from_value(payload).unwrap();
+        assert_eq!(resp.status, RegistrationStatus::Accepted);
+        assert_eq!(resp.interval, 10);
+    }
+
+    #[test]
+    fn parse_call_error() {
+        let text = r#"[4,"7","NotImplemented","Unknown action",{}]"#;
+        match Frame::parse(text).unwrap() {
+            Frame::CallError { id, code, .. } => {
+                assert_eq!(id, "7");
+                assert_eq!(code, "NotImplemented");
+            }
+            other => panic!("unexpected {other:?}"),
+        }
+    }
+
+    #[test]
+    fn rejects_garbage() {
+        assert!(Frame::parse("{}").is_err()); // не массив
+        assert!(Frame::parse("[]").is_err()); // пустой
+        assert!(Frame::parse(r#"[9,"1",{}]"#).is_err()); // неизвестный тип
+        assert!(Frame::parse(r#"[3,"1"]"#).is_err()); // не хватает элементов
+        assert!(Frame::parse(r#"[2,1,"Heartbeat",{}]"#).is_err()); // id не строка
+    }
+}
