@@ -0,0 +1,16 @@
+//! Протокольный слой OCPP: фреймы RPC и типизированные сообщения.
+//! Ничего не знает о сети и Tokio — только данные и (де)сериализация.
+
+pub mod frame;
+pub mod v16;
+
+pub use frame::{Frame, FrameError};
+
+use serde::{de::DeserializeOwned, Serialize};
+
+/// Сообщение-запрос OCPP. Связывает тип запроса с именем action
+/// и с типом ответа, чтобы `call(req)` возвращал правильный тип.
+pub trait Request: Serialize + DeserializeOwned {
+    const ACTION: &'static str;
+    type Response: Serialize + DeserializeOwned;
+}
